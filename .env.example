# ── Required ──────────────────────────────────────────────────────────────────

# Auth token — used for both the API and WebSocket connections
# Generate one: openssl rand -hex 32
NEUROTERM_AUTH_TOKEN=change_me_generate_with_openssl_rand_hex_32

# Encryption key for stored SSH credentials (min 32 chars)
# Generate one: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=change_me_generate_with_openssl_rand_hex_32

# ── Optional ──────────────────────────────────────────────────────────────────

# Port to expose the web UI on
NEUROTERM_PORT=3000

# Default tmux session name created on backend startup
DEFAULT_TMUX_SESSION=neuroterm

# Host path to mount as /workspace inside the container
# This is the folder Claude Code / your tools will work on
HOST_WORKSPACE=/home/youruser/projects

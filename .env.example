# ── Required ──────────────────────────────────────────────────────────────────

# Static bearer token — legacy auth + WebSocket fallback
# Generate: openssl rand -hex 32
NEUROTERM_AUTH_TOKEN=change_me_generate_with_openssl_rand_hex_32

# JWT signing secret — used to sign login tokens
# Generate: openssl rand -hex 32
# If unset, falls back to NEUROTERM_AUTH_TOKEN (the backend logs a warning
# when this happens). Recommended: use a DIFFERENT value than
# NEUROTERM_AUTH_TOKEN — otherwise the static bearer token and the JWT
# signing key are the same secret, and compromising one compromises both.
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# Encryption key for stored SSH credentials (min 32 chars)
# Generate: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=change_me_generate_with_openssl_rand_hex_32

# ── Optional ──────────────────────────────────────────────────────────────────

# Image tag to pull for both backend and frontend, e.g. a release like v1.2.0.
# Defaults to `latest` (the most recent main-branch build pushed to GHCR).
NEUROTERM_VERSION=latest

# Port to expose the web UI on directly (bare docker-compose.yml only; the
# Traefik override replaces this with routed HTTPS access instead)
NEUROTERM_PORT=3000

# Default tmux session name created on backend startup
DEFAULT_TMUX_SESSION=neuroterm

# Host path to mount as /workspace inside the container
HOST_WORKSPACE=/home/youruser/projects

# Allow new user registration after the first admin account is created
# Set to true only temporarily when you need to add more users
ALLOW_REGISTRATION=false

# ── Traefik reverse proxy (only used with docker-compose.traefik.yml) ─────────
# docker compose -f docker-compose.yml -f docker-compose.traefik.yml up -d

# Public hostname Traefik will route to this app, e.g. terminal.example.com
# Must resolve via DNS to the host running Traefik.
NEUROTERM_DOMAIN=terminal.example.com

# Name of the external Docker network your Traefik instance publishes on.
# Must match the network Traefik itself is attached to.
TRAEFIK_NETWORK=traefik

# Traefik certresolver name configured in your Traefik static config
# (e.g. the one pointing at your ACME/Let's Encrypt resolver).
TRAEFIK_CERTRESOLVER=letsencrypt
